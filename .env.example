# Set this to your server's LAN IP before starting (install.sh does it for you).
LAN_IP=127.0.0.1
NULL_GATE_PORT=8088
# Run id -u and id -g; match the owner of this checkout and data directory.
PUID=1000
PGID=1000
# Container time zone, for example Europe/London or America/New_York.
TZ=UTC
# Optional comma-separated local DNS names, for example null-gate.home.arpa
NULL_GATE_HOSTNAMES=
